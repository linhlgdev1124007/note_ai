# Database: SQLite locally or PostgreSQL in Docker
DATABASE_URL=file:./local.db

# Vertex AI / Gemini (required only for AI features)
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_ADC_HOST_PATH=C:/Users/your-user/AppData/Roaming/gcloud/application_default_credentials.json
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=your-vertex-model-id
GEMINI_EMBEDDING_MODEL=text-embedding-005
COOKIE_SECURE=false
ORIGIN=http://localhost:3000
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
